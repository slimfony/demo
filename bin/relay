#!/usr/bin/env php
<?php

declare(strict_types=1);

use Demo\Relay\RelayKernelFactory;
use Demo\Relay\RelayWorker;
use Psr\Log\LoggerInterface;
use Slimfony\Core\Config\Env;
use Slimfony\Core\Worker\ConsumerRunner;

require __DIR__ . '/../vendor/autoload.php';

$kernel = new RelayKernelFactory(Env::fromGlobals(), dirname(__DIR__))->create();
$logger = $kernel->get(LoggerInterface::class);
$worker = $kernel->get(RelayWorker::class);
assert($logger instanceof LoggerInterface && $worker instanceof RelayWorker);

$logger->info('Outbox relay started');

// Stops on SIGTERM after the turn in progress; leaves (and is restarted by the container) when it grows past 64 MiB.
new ConsumerRunner($kernel, $logger, maxMemoryBytes: 64 * 1024 * 1024)->run($worker->tick(...));
