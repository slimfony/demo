{
    "uid": "slimfony-demo",
    "title": "slimfony demo",
    "tags": [
        "slimfony"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "2s",
    "time": {
        "from": "now-5m",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "1s",
            "2s",
            "5s",
            "10s"
        ]
    },
    "editable": false,
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Requests / s",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total[10s]))",
                    "legendFormat": "",
                    "refId": "A",
                    "interval": "2s"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 1,
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "#2DD4BF",
                                "value": null
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background_solid",
                "graphMode": "area",
                "textMode": "value",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                }
            }
        },
        {
