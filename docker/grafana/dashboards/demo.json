        {
            "id": 11,
            "type": "timeseries",
            "title": "Outbox relay: published per second and waiting",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
