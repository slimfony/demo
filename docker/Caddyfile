{
	admin off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	# the container is non-root and has no trust store tools: do not try to install the local CA into one
	skip_install_trust

	servers {
		timeouts {
			read_header 5s
			read_body 30s
			write 60s
			idle 2m
		}
		max_header_size 16KB
	}

	# Warnings and errors only: an access line per request would drown the log at thousands of requests per second.
	# The application writes its own structured JSON log (request id, route, outcome).
	log {
		output stdout
		format json
		level WARN
	}

	frankenphp {
		num_threads 6
		worker {
			file /app/public/index.php
			num 4
			env MAX_REQUESTS 5000
		}
	}
}

(hardening) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
	}
}

(app) {
	encode zstd gzip
	import hardening
	log

	# the api: the PHP worker answers
	@upload path /api/imports /public/drop
	handle @upload {
		request_body {
			max_size 1MB
		}
		root * /app/public
		php_server
	}

	@backend path /api/* /public/* /healthz /readyz /metrics
	handle @backend {
		request_body {
			max_size 64KB
		}
		root * /app/public
		php_server
	}

	# everything else is the static page
	handle {
		root * /app/ui
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Cache-Control "no-cache"
		@assets path /css/* /js/* /vendor/* /fonts/*
		header @assets Cache-Control "public, max-age=300"
		file_server
	}
}

# plain HTTP for a quick local look
:8080 {
	import app
}

# HTTPS with a locally trusted certificate (use a real domain and Caddy gets a public certificate on its own)
localhost:8443 {
	tls internal
	header Strict-Transport-Security "max-age=31536000"
	import app
}
